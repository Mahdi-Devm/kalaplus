{
  "name": "kalaplus",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "format:check": "prettier --check .",
    "check-types": "turbo run check-types",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "prettier": "^3.9.9",
    "turbo": "^2.11.3",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=18"
  },

"devEngines": {
  "packageManager": {
    "name": "pnpm",
    "version": "11.25.0"
  }
},


  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
